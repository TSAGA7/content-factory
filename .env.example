# Frontend (public values only)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable or anon key>

# Edge Function secrets (supabase secrets set ...). Optional: the app falls back to Vault
